{
  "name": "suara-public-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:public": "vite build --mode public",
    "build:operator": "vite build --mode operator",
    "validate:isolation": "node scripts/validate-build-isolation.mjs",
    "build:showcase": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start:voice": "node server/voice-facade.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:redis:engine": "node scripts/qa-redis-engine.mjs",
    "test:showcase": "node --test tests/showcase-contract.test.mjs",
    "test:voice": "node --test tests/voice-*.test.mjs tests/pcm-processor.test.mjs",
    "acceptance:hosted": "node scripts/qa-hosted-acceptance.mjs",
    "preflight:submission": "node scripts/qa-submission-preflight.mjs",
    "preflight:submission:report": "node scripts/qa-submission-preflight.mjs --allow-incomplete",
    "validate:public": "node scripts/validate-public-build.mjs"
  },
  "dependencies": {
    "@vercel/functions": "3.4.3",
    "openai": "7.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "vite": "8.2.2"
  }
}