{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build && node scripts/validate-vercel-build.mjs",
  "outputDirectory": "dist",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/health.js": {
      "maxDuration": 5,
      "supportsCancellation": true
    },
    "api/capabilities.js": {
      "maxDuration": 20,
      "supportsCancellation": true
    },
    "api/session.js": {
      "maxDuration": 20,
      "supportsCancellation": true
    },
    "api/voice/token.js": {
      "maxDuration": 20,
      "supportsCancellation": true
    },
    "api/streaming/token.js": {
      "maxDuration": 20,
      "supportsCancellation": true
    },
    "api/interview/question.js": {
      "maxDuration": 20,
      "supportsCancellation": true
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; connect-src 'self' wss://agents.assemblyai.com wss://streaming.assemblyai.com; font-src 'self'; form-action 'none'; frame-ancestors 'none'; img-src 'self' data:; media-src 'self' blob:; object-src 'none'; script-src 'self'; style-src 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}