# Root-owned systemd EnvironmentFile. Keep mode 0600 and never commit a real key.
ASSEMBLYAI_API_KEY=
# Generate a random code of at least 16 characters; share privately with demo judges.
SUARA_JUDGE_ACCESS_CODE=
SUARA_PUBLIC_ORIGIN=https://__DOMAIN__
SUARA_ALLOWED_HOSTS=__DOMAIN__
SUARA_LISTEN_HOST=127.0.0.1
SUARA_PORT=8787
SUARA_DIST_ROOT=/var/www/suara/current
SUARA_SESSION_RATE_LIMIT=6
SUARA_TOKEN_RATE_LIMIT=2
SUARA_GLOBAL_TOKEN_RATE_LIMIT=6
SUARA_DAILY_TOKEN_LIMIT=60
SUARA_QUOTA_FILE=/var/lib/suaravoice/token-issuance.json
